1. Develop a Java program to get the temperature and print the following status of the weather
according to the given temperature by using else if ladder statement.
Temperature Weather
T<=0 "Its very very cold"
0<T<=10 "Its cold"
10<T<=20 "Its cool out"
20<T<=30 "Its warm"
T>30 "Its hot"

import java.util.*;
public class Main
{
	public static void main(String[] args) {
		System.out.println("Enter temperature:");
		Scanner sc = new Scanner(System.in);
		int temp = sc.nextInt();
		if(temp<=0)
		{
		    System.out.println("Its very very cold");
		}
		else if(temp>0 && temp<=10)
		{
		    System.out.println("Its cold");
		}
		else if(temp>10 && temp<=20)
		{
		    System.out.println("Its cool out");
		}
		else if(temp>20 && temp<=30)
		{
		    System.out.println("Its warm");
		}
		else if(temp>30)
		{
		    System.out.println("Its hot");
		}
	}
}

