8. Write a C program to generate the Fibonacci series up to N terms.


import java.util.*;

public class Main {
  public static void main(String[]args)
  {
    Scanner sc = new Scanner(System.in);
    System.out.print("Enter value of n:");
    int n = sc.nextInt();
    int a=0,b=1,c;
    for(int i=0;i<n;i++)
    {
      System.out.print(a+" ");
      c=a+b;
      a=b;
      b=c;
    }
  }
    
}


