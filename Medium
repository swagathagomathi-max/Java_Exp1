6. Write a Java Program to print hollow Rectangle using star(*) in C
Sample Test case:
Enter number of rows: 4
Enter number of columns: 7
*******
*     *
*     *
*******


import java.util.*;

public class Main {
  public static void main(String[]args)
  {
    Scanner sc = new Scanner(System.in);
    System.out.print("Enter number of rows:");
    int row = sc.nextInt();
    System.out.print("Enter number of columns:");
    int col = sc.nextInt();
    for(int i=0;i<row;i++)
    {
      for(int j=0;j<col;j++)
      {
        if(i==row-1||i==0||j==col-1||j==0)
        {
          System.out.print("*");
        }
        else{
          System.out.print(" ");
        }
      }
      System.out.println();
    }
  }
    
}

